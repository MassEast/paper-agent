apiVersion: v1
kind: Secret
metadata:
  name: related-work-secret
type: Opaque
stringData:
  # Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
  SECRET_KEY: "CHANGE-THIS-TO-A-RANDOM-SECRET"
  SITE_PASSWORD: "CHANGE-THIS-TO-YOUR-CHOSEN-PASSWORD"
  LLM_API_KEY: "CHANGE-THIS-TO-YOUR-LLM-API-KEY"
  RESEND_API_KEY: "CHANGE-THIS-TO-YOUR-RESEND-API-KEY"
  RESEND_FROM: "Related Work Agent <notifications@example.com>"

  SCHOLAR_API_KEY: "CHANGE-THIS-TO-YOUR-SCHOLAR-API-KEY"
  NOTIFIER_TYPE: "resend"
  SERVER_URL: "https://your-domain.example.com"
