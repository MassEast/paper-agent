# Copy this file to .env and fill in real values. Never commit .env.

# --- Required ---

# Any endpoint that speaks the standard chat-completions API — a self-hosted
# vLLM/Ollama/llama.cpp server, a gateway in front of one, or a hosted
# provider. Must serve POST {base}/chat/completions.
# If you self-host inference on the same cluster you deploy this app to, this
# may need a different value here (local dev) than in k8s/deployment.yaml and
# k8s/cronjob.yaml (in-cluster) — e.g. a public/VPN-reachable URL here vs. an
# internal cluster-DNS hostname there. Don't assume they must match.
LLM_API_BASE=http://localhost:8000/v1
LLM_API_KEY=your-llm-api-key

# Comma-separated model names, tried in order as a fallback cascade (if the
# first is unavailable/erroring, the next is tried, etc.). A single model is fine.
# Whatever name(s) your endpoint serves — e.g. what vLLM/Ollama was launched
# with, or a hosted provider's model ID.
LLM_MODELS=your-model-name

SECRET_KEY=any-random-string
SITE_PASSWORD=your-chosen-password

# --- Optional ---

# Defaults to sqlite:////tmp/related_work.db
DATABASE_URL=sqlite:////tmp/related_work.db

# Defaults to logs/ locally
LOGS_DIR=logs

# Used to build links in notification emails. Defaults to http://localhost:5001
SERVER_URL=http://localhost:5001

# Semantic Scholar API key (1 req/s authenticated). Without it, Scholar calls
# are unauthenticated and more likely to hit rate limits (429s).
SCHOLAR_API_KEY=

# Email notifications — pick one notifier, or leave both unset to disable email.
NOTIFIER_TYPE=resend
RESEND_API_KEY=

# Fallback recipient(s) for notification emails when a project has none of its
# own set (comma-separated). Optional — a project's own notification_emails
# always takes priority over this.
NOTIFY_EMAILS=
RESEND_FROM=Related Work Agent <notifications@example.com>

# SMTP fallback (used if NOTIFIER_TYPE=email instead of resend)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Logs every LLM prompt + response to LOGS_DIR/app.log at INFO level (dev only)
LOG_LLM=0

# Manual/testing overrides for the nightly crawl script
CRAWL_HOUR_OVERRIDE=
CRAWL_DAYS_BACK=1

# How many My Collection papers to include as LLM reference/calibration context for
# keyword extraction and relevance screening (prioritized by tag: important > to_discuss
# > to_read > untagged, then newest/oldest alternating within whichever tier runs out of
# slots). This same block of text is repeated in every relevance-check call for a crawl,
# so raising it adds real prompt size per candidate paper — cheap if your inference
# server does prefix caching (the block is identical across a crawl's calls), but it
# still adds to KV-cache memory pressure. Defaults to 15.
REFERENCE_PAPERS_LIMIT=15

# UI cost-comparison figure — not a real cost (self-hosted inference has no
# metered per-token price), just "what this many tokens would cost on a
# metered API," shown for scale. Defaults to Claude Sonnet 4.6 pricing.
LLM_COST_COMPARISON_MODEL=Claude Sonnet 4.6
LLM_COST_COMPARISON_INPUT_PER_1M=3.00
LLM_COST_COMPARISON_OUTPUT_PER_1M=15.00
